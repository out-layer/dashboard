# NEAR Network Configuration - Testnet
NEXT_PUBLIC_TESTNET_CONTRACT_ID=outlayer.testnet
NEXT_PUBLIC_TESTNET_RPC_URL=https://rpc.testnet.fastnear.com?apiKey=YOUR_API_KEY
NEXT_PUBLIC_TESTNET_ARCHIVAL_RPC_URL=https://archival-rpc.testnet.fastnear.com
NEXT_PUBLIC_TESTNET_COORDINATOR_API_URL=http://localhost:8080

# NEAR Network Configuration - Mainnet
NEXT_PUBLIC_MAINNET_CONTRACT_ID=outlayer.near
NEXT_PUBLIC_MAINNET_RPC_URL=https://rpc.mainnet.fastnear.com
NEXT_PUBLIC_MAINNET_ARCHIVAL_RPC_URL=https://archival-rpc.mainnet.fastnear.com
NEXT_PUBLIC_MAINNET_COORDINATOR_API_URL=https://api.outlayer.ai

# Default network (testnet or mainnet)
NEXT_PUBLIC_DEFAULT_NETWORK=testnet

# Set to "false" when testnet workers are offline. The dashboard will then
# show a notice and hide the executions table for users on testnet.
NEXT_PUBLIC_TESTNET_WORKERS_ENABLED=true

# NEAR Block Explorer URLs
NEXT_PUBLIC_TESTNET_EXPLORER_URL=https://testnet.nearblocks.io
NEXT_PUBLIC_MAINNET_EXPLORER_URL=https://nearblocks.io

# Stablecoin Configuration - Testnet
# Use a test token or usdc.fakes.testnet for testing
NEXT_PUBLIC_TESTNET_STABLECOIN_CONTRACT=usdc.fakes.testnet
NEXT_PUBLIC_TESTNET_STABLECOIN_DECIMALS=6
NEXT_PUBLIC_TESTNET_STABLECOIN_SYMBOL=USDC

# Stablecoin Configuration - Mainnet (Native USDC on NEAR)
NEXT_PUBLIC_MAINNET_STABLECOIN_CONTRACT=17208628f84f5d6ad33f0da3bbbeb27ffcb398eac501a31bd6ad2011e36133a1
NEXT_PUBLIC_MAINNET_STABLECOIN_DECIMALS=6
NEXT_PUBLIC_MAINNET_STABLECOIN_SYMBOL=USDC

# Attestation Format Versioning
# Jobs created after this timestamp use V1 format (with caller, project, secrets, payment)
# Jobs before this timestamp use V0 format (original fields only)
# Set this to the deployment timestamp when upgrading to V1
# Unix timestamp for NOW: date +%s
NEXT_PUBLIC_OUTLAYER_ATTESTATION_V1=1769784939

# Connectors whose owner connects an account on /connect/<id>.
# The public half reaches the browser, which builds the provider's links from it;
# the secret stays in the server's process and is used by /connect/<id>/exchange only.
#
# Gmail — a Google OAuth client (Web application), redirect URI <origin>/connect/gmail
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
#
# GitHub — a GitHub App, callback URL <origin>/connect/github, with
# "Request user authorization (OAuth) during installation" ON and
# "Expire user authorization tokens" OFF (the exchange refuses a token that expires).
# The slug is the last segment of the app's public page, github.com/apps/<slug>.
# NEXT_PUBLIC_GITHUB_APP_CLIENT_ID=
# NEXT_PUBLIC_GITHUB_APP_SLUG=
# GITHUB_APP_CLIENT_ID=
# GITHUB_APP_CLIENT_SECRET=
